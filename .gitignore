# Large USB captures - exceed GitHub's 100 MB per-file limit; kept locally only.
*.pcap
captures/

# Raw device-model snapshots + capture-server runtime files. These are full device
# dumps (they contain wifi/SIP/Bluetooth state in plaintext) and transient control
# files, so they are kept LOCAL ONLY and never committed. The decoded, reviewed output
# we DO version is fx_recipes.json (effect parameters only, no secrets).
cap_control/
# Raw model dumps carry plaintext wifi SSIDs + SIP account data. Never commit any .bin
# dump or a full decoded model snapshot.
*.bin

# THE WORKING NOTES LIVE IN A PRIVATE SIBLING REPO, `Claude Projects\_Notes\Access Caster\`, so
# this one can be public. These entries are a safety net, not the mechanism: the files are not here
# at all. A note written back into this folder by mistake must never reach a public remote, because
# a pushed note cannot be taken back.
#
# WHAT IS PUBLIC IS THE FINDINGS AND WHAT IS PRIVATE IS THE CONVERSATION. The hardware findings are
# tracked, in `docs/`, with the code. Anything carrying decisions, quotes or open work stays in the
# private repo. So `docs/` is NOT listed here and `ProjectMemory/` stays denied outright - nothing
# public should be written under the notes folder's name.
ProjectMemory/
ProjectNotes.md
PICKUP.md

# Python
__pycache__/
*.pyc
*.pyo

# Backups / editor cruft
*.bak
*.tmp

# Logs written by DevTools scripts (midi_monitor.log and the like) - transient.
*.log

# Packaging build artifacts (PyInstaller + Inno Setup output). The spec, installer.iss and
# build script (in ProjectBuilds/) ARE versioned; their generated output is not. Everything
# generated lands UNDER ProjectBuilds/ (dist/, build/ and Output/) because build_installer.ps1
# passes --distpath and --workpath; the two root entries stay only to catch a hand-run
# `pyinstaller`, which still defaults to the working directory.
/build/
/dist/
/ProjectBuilds/build/
/ProjectBuilds/dist/
/Output/
/ProjectBuilds/Output/
# The build's own virtual environment, created by build_installer.ps1 from the pinned requirements.
/ProjectBuilds/.venv/
# The exe's Windows version resource, GENERATED from Project/version.py by AccessCaster.spec on
# every build. Committing it would put the version number in a SECOND place, which is the one thing
# version.py's single-source-of-truth rule forbids.
/ProjectBuilds/version_info.generated.txt

# Claude Code per-project settings (may contain machine-specific permission paths).
.claude/

# Third-party installers fetched for a local test. RODE's driver is theirs to distribute, and the
# URL in PROJECT_GUIDE is how to get it again.
_driver/

# Generated at build time from Project/version.py HISTORY
/ProjectBuilds/release-notes.txt
.ruff_cache/
